{
  "name": "ros2-warehouse-amr (headless)",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "args": {
      "USERNAME": "ros"
    }
  },
  "remoteUser": "ros",
  "updateRemoteUserUID": true,
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/ros/ws,type=bind",
  "workspaceFolder": "/home/ros/ws",
  "runArgs": [
    "--network=host",
    "--ipc=host",
    "--cap-add=SYS_PTRACE"
  ],
  "containerEnv": {
    "XDG_RUNTIME_DIR": "/tmp/runtime-ros",
    "ROS_DOMAIN_ID": "42",
    "ROS_AUTOMATIC_DISCOVERY_RANGE": "LOCALHOST"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "mkdir -p -m 700 /tmp/runtime-ros",
  "customizations": {
    "vscode": {
      "extensions": [
        "editorconfig.editorconfig",
        "ms-vscode.cpptools",
        "ms-python.python",
        "redhat.vscode-xml",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "C_Cpp.clang_format_style": "file",
        "C_Cpp.clang_format_path": "/usr/bin/clang-format",
        "files.insertFinalNewline": true,
        "files.trimTrailingWhitespace": true
      }
    }
  }
}
