extends: default

rules:
  document-start: disable
  line-length:
    max: 120
    level: warning
  truthy:
    level: error
    # ROS parameter files (e.g. Nav2) commonly use True/False.
    allowed-values: ["true", "false", "True", "False"]
    # GitHub Actions uses `on:` as a key.
    check-keys: false
  indentation:
    spaces: 2
    indent-sequences: consistent
  comments:
    min-spaces-from-content: 1
