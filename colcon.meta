# Per-package colcon arguments (YAML). colcon reads ./colcon.meta on every run from the
# workspace root, so a plain `colcon build` uses them.
#
# While checks are paused (ADR-004), every package builds without tests: no test targets and
# no lint test tools (such as ament_cmake_clang_format) needed. To build with tests:
#   colcon build --metas /dev/null --cmake-args -DBUILD_TESTING=ON
# (--metas /dev/null skips this file; CMake remembers BUILD_TESTING, so set it explicitly.)
#
# Add every new package here.
names:
  warehouse_bringup:
    cmake-args: [-DBUILD_TESTING=OFF]
  warehouse_description:
    cmake-args: [-DBUILD_TESTING=OFF]
  warehouse_gazebo:
    cmake-args: [-DBUILD_TESTING=OFF]
  # ament_python: `colcon build` never builds or runs its tests, so there is nothing to turn off.
  warehouse_layout: {}
  warehouse_navigation:
    cmake-args: [-DBUILD_TESTING=OFF]
  warehouse_system_tests:
    cmake-args: [-DBUILD_TESTING=OFF]
