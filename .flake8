# Mirrors ament_flake8's configuration (ROS 2 Jazzy) so pre-commit and `colcon test` agree.
[flake8]
extend-ignore = B902,C816,D100,D101,D102,D103,D104,D105,D106,D107,D203,D212,D404,I202
import-order-style = google
max-line-length = 99
show-source = true
statistics = true
exclude = .git,__pycache__,build,install,log
