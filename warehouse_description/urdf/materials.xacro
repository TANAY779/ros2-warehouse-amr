<?xml version="1.0"?>
<!--
  Colours shared by RViz and Gazebo. Gazebo turns a URDF <material> colour into the
  ambient and diffuse colour of the visual.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="body_orange">
    <color rgba="0.95 0.50 0.10 1.0"/>
  </material>
  <material name="scanner_band_black">
    <color rgba="0.12 0.12 0.12 1.0"/>
  </material>
  <material name="deck_grey">
    <color rgba="0.55 0.57 0.60 1.0"/>
  </material>
  <material name="rubber_black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>
  <material name="caster_grey">
    <color rgba="0.35 0.35 0.35 1.0"/>
  </material>
  <material name="sensor_yellow">
    <color rgba="0.95 0.80 0.10 1.0"/>
  </material>

</robot>
