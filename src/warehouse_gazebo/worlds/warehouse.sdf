<?xml version="1.0"?>
<!--
  Generated from warehouse_layout/config/layout.yaml (and the robot size in
  warehouse_description/config/robot.yaml). Do not edit this file: edit layout.yaml,
  then run from the workspace root:
    ros2 run warehouse_layout generate

  The warehouse world: every pose is in the map frame (= this world frame, origin at
  robot1's spawn), and every model is static and stays at the origin. Each solid of the
  layout is one collision box named after it; visuals carry the detail, and the lidar
  (gpu_lidar) sees visuals only. Floor paint has no collision.
-->
<sdf version="1.9">
  <world name="warehouse">

    <!-- As in empty.sdf: 1 ms steps in real time. The controller manager runs at 100 Hz, so
         each control cycle covers 10 physics steps. -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- A world that lists any <plugin> loads only the systems it lists, so every system the
         robot relies on is here (warehouse_gazebo README, "Systems in the world"). -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.6 0.6 0.6 1.0</ambient>
      <background>0.75 0.80 0.85 1.0</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- The floor, in the floor colour. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.6939 0.6867 0.6514 1</ambient>
            <diffuse>0.6939 0.6867 0.6514 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- The hall: walls (a slate band below 1 m), pilasters and door panels. -->
    <model name="walls">
      <static>true</static>
      <link name="link">
        <collision name="wall_south_collision">
          <pose>13.5 -2.1 1.25 0 0 0</pose>
          <geometry><box><size>30.4 0.2 2.5</size></box></geometry>
        </collision>
        <visual name="wall_south_band_visual">
          <pose>13.5 -2.1 0.5 0 0 0</pose>
