<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>warehouse_system_tests</name>
  <version>0.1.0</version>
  <description>Simulation test tools of the warehouse AMR: drive_route drives a route of the location registry, evaluate_localization measures AMCL and odometry against ground truth from a bag, map_timelapse turns a mapping bag into a GIF, and measure_load samples the CPU, memory and Gazebo's real-time factor of a run.</description>
  <maintainer email="tanay.baisware@gmail.com">Tanay Baisware</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/TANAY779/ros2-warehouse-amr</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- Used by the warehouse_system_tests.ros_helpers module -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <!-- ros_helpers reads controllers.yaml from it; evaluate_localization reads robot.yaml
       through robot_config -->
  <exec_depend>warehouse_description</exec_depend>

  <!-- The test tools (drive_route, evaluate_localization, map_timelapse) -->
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <!-- ros2 bag record writes MCAP; reading it needs the MCAP storage plugin -->
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <!-- The location registry (routes) and the [PASS] / [FAIL] lines (RuleResult) -->
  <exec_depend>warehouse_layout</exec_depend>
  <!-- measure_load reads Gazebo's /world/<world>/stats through the gz-transport Python
       bindings (gz.transport13, gz.msgs10), not through ROS -->
  <exec_depend>gz_msgs_vendor</exec_depend>
  <exec_depend>gz_transport_vendor</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
