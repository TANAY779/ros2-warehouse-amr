<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>warehouse_system_tests</name>
  <version>0.1.0</version>
  <description>System-level launch tests of the warehouse AMR (mock-hardware bring-up in CI, Gazebo acceptance checks locally) and the simulation test tools: drive_route, evaluate_localization and map_timelapse.</description>
  <maintainer email="tanay.baisware@gmail.com">Tanay Baisware</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/TANAY779/ros2-warehouse-amr</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- Used by the warehouse_system_tests.ros_helpers module -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <!-- ros_helpers reads robot.yaml and controllers.yaml from it -->
  <exec_depend>warehouse_description</exec_depend>

  <!-- The test tools (drive_route, evaluate_localization, map_timelapse) -->
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <!-- ros2 bag record writes MCAP; reading it needs the MCAP storage plugin -->
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <!-- The location registry (routes) and the [PASS] / [FAIL] lines (RuleResult) -->
  <exec_depend>warehouse_layout</exec_depend>

  <test_depend>ament_cmake_clang_format</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_cmake_ros</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>domain_coordinator</test_depend>
  <test_depend>launch</test_depend>
  <test_depend>launch_ros</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>python3-pytest</test_depend>
  <!-- test_gz_bringup.py spawns its scan target with ros_gz_sim's create -->
  <test_depend>ros_gz_sim</test_depend>
  <test_depend>tf2_msgs</test_depend>
  <!-- The system under test -->
  <test_depend>warehouse_bringup</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
