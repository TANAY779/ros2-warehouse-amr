<?xml version="1.0"?>
<!--
  ros2_control: the hardware interfaces the controllers talk to (plan D2).

  The same joints and sensor are exported for every hardware option; only the plugin
  behind them changes:
    gz    gz_ros2_control/GazeboSimSystem: Gazebo moves the joints and fills in the IMU.
          The gz_ros2_control system plugin below starts the controller manager inside
          Gazebo.
    mock  mock_components/GenericSystem: no simulator. Velocity commands are integrated
          into wheel positions (calculate_dynamics), so odometry moves; the IMU reads
          its initial values. ros2_control_node runs the controller manager.
    real  reserved for a future SystemInterface (the top-level xacro stops on it).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- A state interface; mock hardware starts it at `initial`, Gazebo reads it from the sim. -->
  <xacro:macro name="state" params="name initial">
    <state_interface name="${name}">
      <xacro:if value="${hardware == 'mock'}">
        <param name="initial_value">${initial}</param>
      </xacro:if>
    </state_interface>
  </xacro:macro>

  <xacro:macro name="wheel_interfaces" params="joint">
    <joint name="${joint}">
      <command_interface name="velocity">
        <param name="min">${-robot.limits.wheel_max_velocity}</param>
        <param name="max">${robot.limits.wheel_max_velocity}</param>
      </command_interface>
      <xacro:state name="position" initial="0.0"/>
      <xacro:state name="velocity" initial="0.0"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="robot_ros2_control">
    <ros2_control name="WarehouseAmrSystem" type="system">
      <hardware>
        <xacro:if value="${hardware == 'gz'}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>
        <xacro:if value="${hardware == 'mock'}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">true</param>
        </xacro:if>
      </hardware>

      <xacro:wheel_interfaces joint="left_wheel_joint"/>
      <xacro:wheel_interfaces joint="right_wheel_joint"/>

      <!-- Read by imu_sensor_broadcaster (sensor_name: imu_sensor in controllers.yaml). -->
      <sensor name="imu_sensor">
        <xacro:state name="orientation.x" initial="0.0"/>
        <xacro:state name="orientation.y" initial="0.0"/>
        <xacro:state name="orientation.z" initial="0.0"/>
        <!-- An identity quaternion, so mock hardware publishes a valid orientation. -->
        <xacro:state name="orientation.w" initial="1.0"/>
        <xacro:state name="angular_velocity.x" initial="0.0"/>
        <xacro:state name="angular_velocity.y" initial="0.0"/>
        <xacro:state name="angular_velocity.z" initial="0.0"/>
        <xacro:state name="linear_acceleration.x" initial="0.0"/>
        <xacro:state name="linear_acceleration.y" initial="0.0"/>
        <xacro:state name="linear_acceleration.z" initial="0.0"/>
      </sensor>
    </ros2_control>

    <xacro:if value="${hardware == 'gz'}">
      <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
          <parameters>$(find warehouse_description)/config/controllers.yaml</parameters>
          <!-- The controller manager runs in the robot namespace (/robot1/controller_manager)
               and reads the URDF from /robot1/robot_description, which robot_state_publisher
               publishes. Topics are remapped by the spawner, not here: <ros><remapping> is
               deprecated in ros2_control 4.48 (plan §2.3). -->
          <xacro:if value="${namespace != ''}">
            <ros>
              <namespace>/${namespace}</namespace>
            </ros>
          </xacro:if>
        </plugin>
      </gazebo>
    </xacro:if>
  </xacro:macro>

</robot>
