<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>warehouse_layout</name>
  <version>0.1.0</version>
  <description>The warehouse from one file: layout.yaml, its loader and schema check, the layout fit rules, a to-scale preview picture, and the generators of the Gazebo world, the location registry and the expected inventory.</description>
  <maintainer email="tanay.baisware@gmail.com">Tanay Baisware</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/TANAY779/ros2-warehouse-amr</url>

  <!-- model.load() finds layout.yaml in the package's share directory -->
  <exec_depend>ament_index_python</exec_depend>
  <!-- The preview picture -->
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- robot_config: the robot's dimensions for the fit rules and the preview -->
  <exec_depend>warehouse_description</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <!-- test_generated_files_are_current.py compares the installed world with the layout -->
  <test_depend>warehouse_gazebo</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
